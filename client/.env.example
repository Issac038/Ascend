# ASCEND frontend — environment template
# Copy to .env.development / .env.production as needed. Never put secrets here
# (everything prefixed VITE_ is bundled into the public JS).

# Base URL of the ASCEND backend API (no trailing slash).
# Leave empty in development to use the Vite proxy (/api -> http://localhost:5000).
# In production, set to the real API origin, e.g. https://api.your-domain.com/api
# (for single-origin deploys where Express serves client/dist, leave empty —
# the frontend then uses relative /api on the same origin)
VITE_API_URL=

# Optional: invite code matching the backend's INVITE_CODE for invite-only
# registration. Empty = the field only appears if the server demands one.
VITE_INVITE_CODE=

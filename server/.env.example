# ─────────────────────────────────────────────────────────────
# ASCEND backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server port (backend API)
PORT=5000

# MongoDB connection string (production: use a hosted cluster + strong credentials)
MONGO_URI=

# Secret used to sign auth session JWTs — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated allowlist of frontend origins allowed by CORS, e.g.
# http://localhost:5173,https://ascend.example.com
CLIENT_URL=

# production | development  — controls Secure cookies, CORS strictness, error detail
NODE_ENV=development

# Optional private-deployment gate: if set, registration requires this code
# (entered on the signup form). Leave empty for open registration.
INVITE_CODE=

# Optional: set to "false" to force API-only mode even if client/dist exists
# (use when the frontend is hosted separately, e.g. Netlify/Vercel)
SERVE_STATIC=

# ── Nutrition (FatSecret Platform API) ──
# Create an app at https://platform.fatsecret.com → get Client ID + Secret.
# Used server-side only; never shipped to the frontend.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# FatSecret Image Recognition & Barcode Scanning are PREMIER-exclusive
# (per https://platform.fatsecret.com/docs). Set to "true" ONLY if your
# key has that access (or a vision provider is wired into
# server/services/imageRecognitionService.js). Default: unavailable state.
NUTRITION_PHOTO_ENABLED=
NUTRITION_BARCODE_ENABLED=

# ── Password-reset emails (optional) ──
# If SMTP_HOST is left empty, reset codes are logged server-side and the API
# responds with a generic message (password reset is effectively disabled
# until an email provider is configured — this is intentional and honest).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ASCEND <no-reply@example.com>"

# ── Frontend build-time variable (set in client/.env.production when deploying) ──
# VITE_API_URL=https://api.example.com/api
